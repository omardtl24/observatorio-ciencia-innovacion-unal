########################################
# ============= DATABASE ==============
########################################

DB_HOST=db
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=postgres

########################################
# ============== AUTH0 ================
########################################

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace_me
AUTH0_CLIENT_SECRET=replace_me
AUTH0_CALLBACK_URL=http://localhost/api/auth/callback

########################################
# ======= LOOKER STUDIO / OAUTH =======
########################################
CLIENT_ID=replace_me
CLIENT_SECRET=replace_me
REDIRECT_URI=http://localhost
REFRESH_TOKEN=

########################################
# ========== JWT / SECURITY ===========
########################################
FLASK_SECRET_KEY=KEY
RESTRICTED_EMAIL_DOMAIN=unal.edu.co
FRONTEND_URL=http://localhost
DEFAULT_ADMIN_EMAIL=xxxxx@unal.edu.co
TEST=false
SESSION_LIFETIME_SECONDS=7200
OAUTH_STATE_TTL_SECONDS=300

######################################
# ============ FILE STORAGE ============
######################################
FILE_STORAGE_ROOT=/srv/resources/data_sources
RESOURCES_BASE_URL=http://localhost:8081/
SHINY_CONTAINER_NAME=app_shiny_dev

# Profile image cache (login avatars)
PROFILE_IMAGE_CACHE_TTL_SECONDS=86400
PROFILE_IMAGE_CLEANUP_INTERVAL_SECONDS=900

# Orphaned files garbage collector: grace period before an unlinked/untracked
# file is considered orphaned, and how often the background sweep runs.
# 86400 = 1 day. For production, consider a longer grace period (e.g.
# 2592000 = 30 days) to comfortably outlast any slow admin workflow.
ORPHANED_FILES_GRACE_PERIOD_SECONDS=86400
ORPHANED_FILES_CLEANUP_INTERVAL_SECONDS=3600

# prod
POPULATE=true