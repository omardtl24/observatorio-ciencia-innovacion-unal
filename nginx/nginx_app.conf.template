worker_processes auto;

events {
    worker_connections 1024;
}

http {
    lua_package_path "/etc/nginx/lua/?.lua;/etc/nginx/lua/?/init.lua;;";

    include       mime.types;
    default_type  application/octet-stream;

    log_format docker_pretty
        '$remote_addr - [$time_local] '
        '"$request" $status '
        'route=$route '
        'upstream=$upstream_addr '
        'time=$request_time '
        'rt=$upstream_response_time '
        'uri=$request_uri '
        'upgrade=$http_upgrade '
        'ua="$http_user_agent"';

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # =========================
    # HTTP → HTTPS redirect
    # =========================
    server {
        listen 80;
        server_name observatorio-ciencia-innovacion;

        return 301 https://$host$request_uri;
    }

    # =========================
    # HTTPS SERVER (MAIN)
    # =========================
    server {
        listen 443 ssl;
        server_name observatorio-ciencia-innovacion;

        resolver 127.0.0.11 valid=30s ipv6=off;

        ssl_certificate     /etc/nginx/ssl/nginx.crt;
        ssl_certificate_key /etc/nginx/ssl/nginx.key;

        ssl_protocols TLSv1.2 TLSv1.3;

        access_log /dev/stdout docker_pretty;
        error_log /dev/stderr warn;

        client_max_body_size 350M;

        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        rewrite_by_lua_block {
            local uri = ngx.var.uri
            local normalized = ngx.re.gsub(
                uri,
                [[^/(server/)?(simulator|visor)/(\d+)$]],
                "$1$2/$3/",
                "jo"
            )
            if normalized and normalized ~= uri then
                ngx.req.set_uri(normalized, false)
            end
        }

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /ping {
            access_log off;
            default_type text/plain;
            return 200 "running\n";
        }

        location /api/ {
            set $route "backend";

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;

            rewrite ^/api/(.*)$ /$1 break;

            proxy_pass http://backend:5000;
        }

        location / {
            set $route "frontend";

            proxy_http_version 1.1;

            # In prod, an upstream Apache strips the app prefix before the
            # request reaches this nginx, so it must be added back here
            # since Vite's `base` expects it. In dev, this nginx is hit
            # directly and the prefix is already present — only add it
            # when it's missing, so the same rule works in both setups.
            rewrite ^/(?!app-observatorio-analisis-indicadores(?:/|$))(.*)$ /app-observatorio-analisis-indicadores/$1 break;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_cache_bypass $http_upgrade;

            proxy_pass http://frontend:5173;
        }

        location ~ ^/server/(?<route>simulator|visor)/(?<resource_id>\d+)(?<resource_path>/.*)?$ {

            access_by_lua_block {
                local access_control = require("access_control")

                local jwt = ngx.var.cookie_user_jwt
                if jwt then
                    jwt = ngx.unescape_uri(jwt)
                end

                local ok, status_code, message =
                    access_control.validate_access(
                        ngx.var.route,
                        ngx.var.resource_id,
                        jwt
                    )

                if not ok then
                    ngx.status = status_code or ngx.HTTP_FORBIDDEN
                    ngx.header["Content-Type"] = "text/plain; charset=utf-8"
                    ngx.say(message or "Acceso denegado")
                    return ngx.exit(ngx.status)
                end
            }

            proxy_set_header Host shinyserver:3838;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;

            proxy_pass http://shinyserver:3838/$route/$resource_id$resource_path$is_args$args;
        }
    }
}